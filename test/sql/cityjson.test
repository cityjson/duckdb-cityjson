# name: test/sql/cityjson.test
# description: Test read_cityjson table function
# group: [sql]

require cityjson

# Test basic CityJSON reading
statement ok
CREATE TABLE buildings AS SELECT * FROM read_cityjson('test/data/minimal.city.json');

# Verify the table was created
query I
SELECT COUNT(*) FROM buildings;
----
1

# Check that we have the expected columns
query I
SELECT COUNT(*) FROM (SELECT * FROM buildings LIMIT 0);
----
0

# Test feature_id column
query I
SELECT COUNT(*) FROM buildings WHERE feature_id IS NOT NULL;
----
1

# Test object_type column
query T
SELECT object_type FROM buildings;
----
Building

# Test attribute column (yearOfConstruction)
query I
SELECT yearOfConstruction FROM buildings;
----
2020

# Test CityJSONSeq format
statement ok
CREATE TABLE buildings_seq AS SELECT * FROM read_cityjson('test/data/sample.city.jsonl');

# Verify we got 2 buildings from the sequence file
query I
SELECT COUNT(*) FROM buildings_seq;
----
2

# Test that both buildings have the correct type
query I
SELECT COUNT(*) FROM buildings_seq WHERE object_type = 'Building';
----
2

# ============================================================
# sample_lines parameter for regular CityJSON
# ============================================================

# With sample_lines=1 the late attribute is not discovered
query I
SELECT COUNT(*) FROM (DESCRIBE SELECT * FROM read_cityjson('test/data/cityjson_late_attribute.city.json', sample_lines => 1)) WHERE column_name = 'lateAttribute';
----
0

# With default sampling the late attribute is present
query I
SELECT COUNT(*) FROM (DESCRIBE SELECT * FROM read_cityjson('test/data/cityjson_late_attribute.city.json')) WHERE column_name = 'lateAttribute';
----
1

# Negative sample_lines is rejected
statement error
SELECT * FROM read_cityjson('test/data/cityjson_late_attribute.city.json', sample_lines => -1);
----
sample_lines must be non-negative

# ============================================================
# Filter pushdown
# ============================================================

# object_type equality filter is pushed down
query I
SELECT id FROM read_cityjson('test/data/minimal.city.json') WHERE object_type = 'Building';
----
building1

# id equality filter is pushed down
query I
SELECT object_type FROM read_cityjson('test/data/minimal.city.json') WHERE id = 'building1';
----
Building

# non-existent pushed-down filter returns no rows
query I
SELECT COUNT(*) FROM read_cityjson('test/data/minimal.city.json') WHERE id = 'no-such-building';
----
0

# non-pushable filter still works
query I
SELECT COUNT(*) FROM read_cityjson('test/data/minimal.city.json') WHERE object_type = 'Building' AND yearOfConstruction > 2010;
----
1

# Clean up
statement ok
DROP TABLE buildings;

statement ok
DROP TABLE buildings_seq;
