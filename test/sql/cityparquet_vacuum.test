# name: test/sql/cityparquet_vacuum.test
# description: cityjson_appearance_ids, cityparquet_orphans, cityparquet_vacuum
# group: [sql]

require cityjson

# --- cityjson_appearance_ids ------------------------------------------------

# The cell's MAP type says whether it holds materials or textures, so there is no
# kind argument: the overload is chosen by the type.

# material: one id per WKB face, deduplicated, nulls ignored.
query T
SELECT cityjson_appearance_ids(MAP {'visual': [0, 0, 1, 1, NULL, 2]}::MAP(VARCHAR, BIGINT[]));
----
[0, 1, 2]

# Every theme contributes; the outer key set is dynamic.
query T
SELECT cityjson_appearance_ids(MAP {'a': [1, 1], 'b': [2, NULL]}::MAP(VARCHAR, BIGINT[]));
----
[1, 2]

# texture: per face, per ring. Only the struct's id is a reference -- the uv pairs
# are coordinates -- and a bare ring contributes nothing.
query T
SELECT cityjson_appearance_ids(MAP {'visual': [
  [{'id': 0, 'uv': [[0.0, 0.0], [1.0, 0.0], [1.0, 1.0]]}],
  [{'id': 5, 'uv': [[0.5, 0.25], [0.5, 0.5], [0.25, 0.5]]}, {'id': NULL, 'uv': NULL}]
]}::MAP(VARCHAR, STRUCT(id BIGINT, uv DOUBLE[][])[][]));
----
[0, 5]

query I
SELECT cityjson_appearance_ids(NULL::MAP(VARCHAR, BIGINT[])) IS NULL;
----
true

# Anything that is not one of the two cell types is refused at bind, which is what
# keeps an ordinary attribute out (see the `look` schema at the end of this file).
statement error
SELECT cityjson_appearance_ids('{}');
----
expected a MAP(VARCHAR, BIGINT[]) (material) or MAP(VARCHAR, STRUCT(id BIGINT, uv DOUBLE[][])[][]) (texture) cell

# --- orphans and vacuum ------------------------------------------------------

statement ok
CREATE SCHEMA ams;

statement ok
CREATE TABLE ams.building AS
  SELECT * FROM read_cityjsonseq('test/data/railway_appearance.city.jsonl');

# The fixture's material_lod3_0 cells reference ids 0 and 1. Id 999 references
# nothing.
statement ok
CREATE TABLE ams.materials (id BIGINT, name VARCHAR);

statement ok
INSERT INTO ams.materials VALUES (0, 'used'), (1, 'used'), (999, 'orphaned');

statement ok
PRAGMA cityparquet_init('ams');

statement ok
PRAGMA cityparquet_orphans('ams');

query TTT
SELECT table_name, id, reason FROM cityparquet_orphan_rows;
----
materials	999	unreferenced

statement ok
PRAGMA cityparquet_vacuum('ams');

query I
SELECT COUNT(*) FROM ams.materials WHERE id = 999;
----
0

# The referenced materials survive — vacuum must not invert its own test.
query I
SELECT COUNT(*) FROM ams.materials;
----
2

# Vacuum is idempotent and leaves nothing orphaned.
statement ok
PRAGMA cityparquet_vacuum('ams');

statement ok
PRAGMA cityparquet_orphans('ams');

query I
SELECT COUNT(*) FROM cityparquet_orphan_rows;
----
0

# Deleting the objects that referenced a material orphans it, and vacuum then
# reclaims it — the delete/vacuum split the design calls for, since orphanhood is
# a whole-package property rather than a per-delete one.
statement ok
PRAGMA cityparquet_delete('ams', 'id = ''GMLID_855011_330784_753''');

statement ok
PRAGMA cityparquet_orphans('ams');

query I
SELECT COUNT(*) > 0 FROM cityparquet_orphan_rows;
----
true

statement ok
PRAGMA cityparquet_vacuum('ams');

statement ok
PRAGMA cityparquet_orphans('ams');

query I
SELECT COUNT(*) FROM cityparquet_orphan_rows;
----
0

# The _sql twin returns text and mutates nothing.
query I
SELECT cityparquet_vacuum_sql('ams') LIKE '%DELETE FROM%NOT IN%';
----
true

# --- geometry templates hold appearance too ---------------------------------

# A material referenced only by a geometry template must not be vacuumed: the
# template sidecar carries its own appearance columns.
#
# id is BIGINT, matching the real geometry_templates.parquet schema
# (cityjson_geometry_templates) -- ams.building now carries a reserved `template`
# STRUCT(id BIGINT, ...) column (spec 02-object-table-schema.mdx), so
# ReferencedIds compares template.id against this table's id and a VARCHAR here
# would be a type mismatch, not merely an unrealistic fixture.
statement ok
CREATE TABLE ams.geometry_templates (id BIGINT, material_lod1_0 MAP(VARCHAR, BIGINT[]));

statement ok
INSERT INTO ams.geometry_templates VALUES (1, MAP {'visual': [42]}::MAP(VARCHAR, BIGINT[]));

statement ok
INSERT INTO ams.materials VALUES (42, 'used-only-by-a-template');

statement ok
PRAGMA cityparquet_init('ams');

statement ok
PRAGMA cityparquet_vacuum('ams');

query I
SELECT COUNT(*) FROM ams.materials WHERE id = 42;
----
1

# The template row itself must survive too -- ams.building's `template` column
# is always NULL (this reader does not populate it yet), so a real reference
# to id 1 is nowhere for ReferencedIds to find. That must read as
# "undeterminable", not "nothing references template 1".
query I
SELECT COUNT(*) FROM ams.geometry_templates;
----
1

# An ordinary attribute that merely starts with the appearance prefix is not an
# appearance column, so orphan detection must not hand it to
# cityjson_appearance_ids -- a VARCHAR attribute matches neither overload.
statement ok
CREATE SCHEMA look;

statement ok
CREATE TABLE look.building AS
  SELECT * FROM read_cityjsonseq('test/data/appearance_lookalike.city.jsonl');

statement ok
CREATE TABLE look.materials (id BIGINT, name VARCHAR);

statement ok
PRAGMA cityparquet_init('look');

statement ok
PRAGMA cityparquet_orphans('look');
