# name: test/sql/cityjson_geographical_extent_other.test
# description: a CityObject's source geographicalExtent has no reserved column and does not survive read-back; COPY TO reconstructs it from bbox instead
# group: [sql]

#
# Fixture: test/data/delft_subset.city.jsonl (real 3DBAG data, not produced by this
# extension). Its Building CityObjects carry a source `geographicalExtent`; its
# BuildingPart children do not.
#
# `other` no longer carries geographicalExtent (other-column simplification,
# duckdb-cityjson task 7): the source's own declared extent is discarded on
# read, since `bbox` already carries the object's extent and `other` now holds
# only members with no column of their own. COPY TO's existing bbox fallback
# (copy_function.cpp) is the only path left to populate the output's
# geographicalExtent member, so the round-tripped value is bbox-derived, not the
# source's verbatim declaration -- those differ (bbox is unioned across
# LoDs/descendants and derived from geometry).
#

require cityjson

# The spec's reserved-column list has no dedicated `geographical_extent` column --
# `bbox` (derived from geometry) is a different thing.
query I
SELECT COUNT(*) FROM (DESCRIBE SELECT * FROM read_cityjsonseq('test/data/delft_subset.city.jsonl'))
WHERE column_name = 'geographical_extent';
----
0

# The source's per-object geographicalExtent has no column of its own, and is no
# longer preserved in `other` either -- there is nothing left for it to survive in.
query I
SELECT other IS NULL
FROM read_cityjsonseq('test/data/delft_subset.city.jsonl')
WHERE id = 'NL.IMBAG.Pand.0503100000012869';
----
true

# A BuildingPart child has no source geographicalExtent, so `other` never
# synthesises one -- nothing may fail on its absence.
query I
SELECT other NOT LIKE '%geographicalExtent%' OR other IS NULL
FROM read_cityjsonseq('test/data/delft_subset.city.jsonl')
WHERE object_type = 'BuildingPart' LIMIT 1;
----
true

statement ok
COPY (SELECT * FROM read_cityjsonseq('test/data/delft_subset.city.jsonl'))
TO '__TEST_DIR__/delft_ge_roundtrip.city.jsonl' (FORMAT cityjsonseq);

# With `other`'s geographicalExtent gone, COPY ... TO cityjson falls back to
# `bbox` (copy_function.cpp) for every object that has one -- so the written
# geographicalExtent is the bbox-derived value, not the source's verbatim
# declared extent.
query I
SELECT content LIKE '%[84593.249625,446459.603,0.47500262451171693,84597.507625,446462.774,3.225002624511717]%'
FROM read_text('__TEST_DIR__/delft_ge_roundtrip.city.jsonl');
----
true

# Neither `other` nor `bbox`: a projection with no bbox column, restricted to a
# BuildingPart (no source geographicalExtent) writes no geographicalExtent member
# at all -- absence is not an error, and there is nothing to fall back to.
statement ok
COPY (
    SELECT id, feature_id, object_type, children, parents, children_roles, other
    FROM read_cityjsonseq('test/data/delft_subset.city.jsonl')
    WHERE object_type = 'BuildingPart'
)
TO '__TEST_DIR__/delft_ge_no_bbox.city.jsonl' (FORMAT cityjsonseq);

# The object's own JSON body has no geographicalExtent key at all -- if the
# fallback had fired wrongly it would insert alphabetically before "geometry" and
# this exact substring would no longer match. (The file's header line still
# carries the *dataset-level* metadata.geographicalExtent, inherited from the
# source unconditionally -- a different thing, untouched by this change -- so the
# assertion is scoped to this one CityObject's body rather than the whole file.)
query I
SELECT content LIKE '%"NL.IMBAG.Pand.0503100000012869-0":{"geometry":[],"parents":["NL.IMBAG.Pand.0503100000012869"],"type":"BuildingPart"}%'
FROM read_text('__TEST_DIR__/delft_ge_no_bbox.city.jsonl');
----
true
