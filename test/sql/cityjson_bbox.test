# name: test/sql/cityjson_bbox.test
# description: Per-row bbox column for per-LOD WKB reader
# group: [sql]

require cityjson

statement ok
CREATE TABLE b AS SELECT * FROM read_cityjson('test/data/minimal.city.json', lod => '2.2');

# bbox is a 3D extent STRUCT
query T
SELECT typeof(bbox) FROM b;
----
STRUCT(xmin DOUBLE, ymin DOUBLE, zmin DOUBLE, xmax DOUBLE, ymax DOUBLE, zmax DOUBLE)

# bbox computed from geometry vertices (0,0,0)..(10,10,0), identity transform
query RRRRRR
SELECT bbox.xmin, bbox.ymin, bbox.zmin, bbox.xmax, bbox.ymax, bbox.zmax FROM b;
----
0.0	0.0	0.0	10.0	10.0	0.0

statement ok
DROP TABLE b;

# Default (non-LOD) mode also exposes a single bbox column (CityParquet wide layout)
query I
SELECT COUNT(*) FILTER (WHERE column_name = 'bbox')
FROM (DESCRIBE SELECT * FROM read_cityjson('test/data/minimal.city.json'));
----
1

# Default-mode bbox is a 3D extent STRUCT computed from the highest-LOD geometry
statement ok
CREATE TABLE bdef AS SELECT * FROM read_cityjson('test/data/minimal.city.json');

query T
SELECT typeof(bbox) FROM bdef;
----
STRUCT(xmin DOUBLE, ymin DOUBLE, zmin DOUBLE, xmax DOUBLE, ymax DOUBLE, zmax DOUBLE)

query RRRRRR
SELECT bbox.xmin, bbox.ymin, bbox.zmin, bbox.xmax, bbox.ymax, bbox.zmax FROM bdef;
----
0.0	0.0	0.0	10.0	10.0	0.0

statement ok
DROP TABLE bdef;

# CityJSONSeq per-LOD mode also exposes geometry_lod2_2 + bbox (streaming bind)
statement ok
CREATE TABLE bseq AS SELECT * FROM read_cityjsonseq('test/data/bbox_seq.city.jsonl', lod => '2.2');

query I
SELECT COUNT(*) FROM bseq;
----
1

query T
SELECT typeof(bbox) FROM bseq;
----
STRUCT(xmin DOUBLE, ymin DOUBLE, zmin DOUBLE, xmax DOUBLE, ymax DOUBLE, zmax DOUBLE)

query RRRRRR
SELECT bbox.xmin, bbox.ymin, bbox.zmin, bbox.xmax, bbox.ymax, bbox.zmax FROM bseq;
----
0.0	0.0	0.0	10.0	10.0	0.0

query T
SELECT typeof(geometry_lod2_2) FROM bseq WHERE geometry_lod2_2 IS NOT NULL;
----
BLOB

statement ok
DROP TABLE bseq;

# bbox is unioned across every stored LoD *and* across the object's descendants
# (CityParquet spec). A parent Building carrying only an LoD0 footprint must not
# report a flat bbox that excludes its BuildingPart's solid, or a query pruning
# on the parent silently misses the building — the normal 3DBAG shape.
query I
SELECT COUNT(*) FROM read_cityjsonseq('test/data/delft_subset.city.jsonl')
WHERE parents IS NULL AND bbox.zmax <= bbox.zmin;
----
0

# Every parent's bbox contains its child's.
query I
SELECT COUNT(*) FROM read_cityjsonseq('test/data/delft_subset.city.jsonl') p
JOIN read_cityjsonseq('test/data/delft_subset.city.jsonl') c ON c.id = p.children[1]
WHERE p.bbox.zmax < c.bbox.zmax OR p.bbox.zmin > c.bbox.zmin
   OR p.bbox.xmin > c.bbox.xmin OR p.bbox.xmax < c.bbox.xmax;
----
0

# `bbox` is a reserved column (spec 02-object-table-schema.mdx: "column nullable;
# the six struct fields are non-null") -- present regardless of whether any object
# in the table has geometry at all. The per-LoD exception in the same spec section
# covers only the geometry_lod*/geometry_properties_lod*/material_lod*/texture_lod*
# family, not bbox. cityparquet-rs pushes bbox unconditionally too (model.rs).
query I
SELECT COUNT(*) FROM (DESCRIBE SELECT * FROM read_cityjson('test/data/no_geometry.city.json'))
WHERE column_name = 'bbox';
----
1

query T
SELECT bbox FROM read_cityjson('test/data/no_geometry.city.json');
----
NULL
