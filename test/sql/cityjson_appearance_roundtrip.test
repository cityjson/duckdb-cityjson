# name: test/sql/cityjson_appearance_roundtrip.test
# description: appearance definitions survive a COPY, so material/texture refs resolve
# group: [sql]

require cityjson

# Only the per-geometry material/texture *references* are columns; the definitions
# they index live in the source file's `appearance` object. Writing the refs
# without the definitions -- which is what happened until now -- emits indices
# into an array that does not exist: invalid CityJSON that still passes a
# refs-only test.

statement ok
COPY (SELECT * FROM read_cityjsonseq('test/data/railway_appearance.city.jsonl'))
TO '__TEST_DIR__/appearance.city.jsonl' (FORMAT cityjsonseq);

# 4 materials in, 4 materials out. Before this fix: 0.
query II
SELECT
  (SELECT COUNT(*) FROM cityjson_materials('test/data/railway_appearance.city.jsonl')),
  (SELECT COUNT(*) FROM cityjson_materials('__TEST_DIR__/appearance.city.jsonl'));
----
4	4

query II
SELECT
  (SELECT COUNT(*) FROM cityjson_textures('test/data/railway_appearance.city.jsonl')),
  (SELECT COUNT(*) FROM cityjson_textures('__TEST_DIR__/appearance.city.jsonl'));
----
4	4

# Identity, not just cardinality. Counts alone would survive a merge of the
# per-feature blocks into one array -- which would also silently re-point every
# reference, since a feature's refs are LOCAL indices into its own block.
query I
SELECT COUNT(*) FROM (
  SELECT id, name, diffuseColor FROM cityjson_materials('test/data/railway_appearance.city.jsonl')
  EXCEPT
  SELECT id, name, diffuseColor FROM cityjson_materials('__TEST_DIR__/appearance.city.jsonl')
);
----
0

query I
SELECT COUNT(*) FROM (
  SELECT id, image_uri, wrapMode FROM cityjson_textures('test/data/railway_appearance.city.jsonl')
  EXCEPT
  SELECT id, image_uri, wrapMode FROM cityjson_textures('__TEST_DIR__/appearance.city.jsonl')
);
----
0

# The written file must actually contain an appearance object.
query I
SELECT content LIKE '%"appearance"%' FROM read_text('__TEST_DIR__/appearance.city.jsonl');
----
true

# No dangling reference: every material index a row carries must be in range of
# the materials actually written.
query I
SELECT COUNT(*) FROM read_cityjsonseq('__TEST_DIR__/appearance.city.jsonl')
WHERE material_lod3_0 IS NOT NULL
  AND list_max(cityjson_appearance_ids(material_lod3_0))
      >= (SELECT COUNT(*) FROM cityjson_materials('__TEST_DIR__/appearance.city.jsonl'));
----
0

# A CityJSONSeq source whose features carry their own materials/textures cannot
# become one whole-document CityJSON: the HEADER only has room for one appearance
# block, so re-attaching it (WriteCityJSON) would drop every per-feature block and
# leave GMLID_855011_330784_753's material refs pointing at whichever definitions
# happened to land in the header instead.
statement error
COPY (SELECT * FROM read_cityjsonseq('test/data/railway_appearance.city.jsonl'))
TO '__TEST_DIR__/appearance.city.json' (FORMAT cityjson);
----
carry their own materials or textures

# --- Task 4: COPY re-nests the flat appearance cells and rebuilds vertices-texture --
# the file, not the row, is the oracle (both the two prior blocks' checks read the
# `appearance` block only, which LoadSourceAppearance carries across regardless of
# whether the per-geometry cell round-trips).

# A Solid's material comes back nested per shell.
statement ok
COPY (SELECT * FROM read_cityjson('test/data/solid_material.city.json', lod := '2.2'))
TO '__TEST_DIR__/solid_material_rt.city.json' (FORMAT cityjson);

query I
SELECT regexp_matches(content, '"material":\{"visual":\{"values":\[\[[0-9,]+\]\]\}\}')
FROM read_text('__TEST_DIR__/solid_material_rt.city.json');
----
true

query I
SELECT COUNT(*) FROM (
  SELECT material_lod2_2['visual'] FROM read_cityjson('__TEST_DIR__/solid_material_rt.city.json', lod := '2.2')
  EXCEPT ALL
  SELECT material_lod2_2['visual'] FROM read_cityjson('test/data/solid_material.city.json', lod := '2.2')
);
----
0

# A texture's UV pairs come back as indices into a rebuilt vertices-texture pool
# (solid_texture.city.json carries a texture only, no material).
statement ok
COPY (SELECT * FROM read_cityjson('test/data/solid_texture.city.json', lod := '2.2'))
TO '__TEST_DIR__/solid_texture_rt.city.json' (FORMAT cityjson);

# A ring is an id followed by four integer UV indices, never [u, v] pairs, and the pool exists.
query II
SELECT regexp_matches(content, '\[0,[0-9]+,[0-9]+,[0-9]+,[0-9]+\]'),
       regexp_matches(content, '"vertices-texture":\[\[')
FROM read_text('__TEST_DIR__/solid_texture_rt.city.json');
----
true	true

# Reading the written file back yields the same cell as the source: value-equal round trip.
query I
SELECT COUNT(*) FROM (
  SELECT texture_lod2_2['visual'][1][1].uv
  FROM read_cityjson('__TEST_DIR__/solid_texture_rt.city.json', lod := '2.2')
  EXCEPT ALL
  SELECT texture_lod2_2['visual'][1][1].uv
  FROM read_cityjson('test/data/solid_texture.city.json', lod := '2.2')
);
----
0

# The per-feature pool takes the same path through CityJSONSeq (WriteCityJSONSeq's own
# BuildTexturePool call, separate code from WriteCityJSON's document-level one above) --
# railway_appearance.city.jsonl's one textured feature proves that path too.
statement ok
COPY (SELECT * FROM read_cityjsonseq('test/data/railway_appearance.city.jsonl'))
TO '__TEST_DIR__/appearance_seq_rt.city.jsonl' (FORMAT cityjsonseq);

# Two lines carry it: the header's own (LoadSourceAppearance's verbatim carry, unrelated
# to any geometry -- the header has none) and the one textured feature's rebuilt pool.
query I
SELECT COUNT(*) FROM (
  SELECT UNNEST(string_split(content, chr(10))) AS line FROM read_text('__TEST_DIR__/appearance_seq_rt.city.jsonl')
) WHERE line LIKE '%"vertices-texture":[[%';
----
2

query I
SELECT COUNT(*) FROM (
  SELECT texture_lod3_0['visual'] AS t
  FROM read_cityjsonseq('__TEST_DIR__/appearance_seq_rt.city.jsonl')
  WHERE id = 'GMLID_BUI100628_817_8083'
  EXCEPT ALL
  SELECT texture_lod3_0['visual']
  FROM read_cityjsonseq('test/data/railway_appearance.city.jsonl')
  WHERE id = 'GMLID_BUI100628_817_8083'
);
----
0

# --- A source read with appearance := 'sidecar' carries dataset-global ids in its
#     material/texture cells. The CityJSON family re-attaches each feature's own LOCAL
#     appearance block (its `materials`/`textures` arrays), which the sidecar ids do
#     not index into -- there is no materials_query/textures_query escape hatch here,
#     unlike the mesh formats, so this must refuse unconditionally rather than write a
#     file whose refs and definitions silently disagree.
statement error
COPY (SELECT * FROM read_cityjsonseq('test/data/railway_appearance.city.jsonl', appearance := 'sidecar'))
TO '__TEST_DIR__/sidecar_refused.city.jsonl' (FORMAT cityjsonseq);
----
read with appearance := 'sidecar'

# --- A cell that violates the column's own invariants (here: a ring's `id` and `uv`
#     disagreeing on nullness) is invalid input, not an appearance to silently drop --
#     `MaterialCellFromValue`/`TextureCellFromValue`'s InvalidInputException propagates,
#     wrapped once with the object id and column name.
statement error
COPY (SELECT * REPLACE (MAP {'visual': [[{'id': 5, 'uv': NULL}]]}::MAP(VARCHAR, STRUCT(id BIGINT, uv DOUBLE[][])[][]) AS texture_lod2_2)
      FROM read_cityjson('test/data/solid_texture.city.json', lod := '2.2'))
TO '__TEST_DIR__/bad_cell.city.json' (FORMAT cityjson);
----
object cube: texture_lod2_2: texture cell: a ring's id and uv must be NULL together

# --- A cell shorter than the geometry it is attached to is invalid input too: the
#     six-face Solid of solid_material.city.json gets a two-entry `visual` list, which
#     `RenestValues`' single-shell fallback would otherwise wrap as `{"values":[[0,1]]}`
#     -- valid-looking CityJSON that silently drops four faces' worth of material.
statement error
COPY (SELECT * REPLACE (MAP {'visual': [0, 1]}::MAP(VARCHAR, BIGINT[]) AS material_lod2_2)
      FROM read_cityjson('test/data/solid_material.city.json', lod := '2.2'))
TO '__TEST_DIR__/short_cell.city.json' (FORMAT cityjson);
----
theme 'visual' has 2 entries for 6 faces

# --- FlatCityBuf gets the same appearance carry-through as CityJSON/CityJSONSeq:
#     fcb::writer::geom_encoder reads a geometry's own material/texture straight off
#     the standard CityJSON shape apply_appearance already produces, and
#     header_serializer reads `appearance` off the metadata line the same way it reads
#     `type`/`version`/`transform` -- so attaching the rebuilt block (materials/textures
#     verbatim, vertices-texture freshly interned) is all a feature needs.
statement ok
COPY (SELECT * FROM read_cityjsonseq('test/data/railway_appearance.city.jsonl'))
TO '__TEST_DIR__/appearance_rt.fcb' (FORMAT flatcitybuf);

query I
SELECT COUNT(*) FROM (
  SELECT material_lod3_0['visual'] AS m
  FROM read_flatcitybuf('__TEST_DIR__/appearance_rt.fcb')
  WHERE id = 'GMLID_855011_330784_753'
  EXCEPT ALL
  SELECT material_lod3_0['visual']
  FROM read_cityjsonseq('test/data/railway_appearance.city.jsonl', lod => '3')
  WHERE id = 'GMLID_855011_330784_753'
);
----
0

query I
SELECT COUNT(*) FROM (
  SELECT texture_lod3_0['visual'][1][1].uv AS uv
  FROM read_flatcitybuf('__TEST_DIR__/appearance_rt.fcb')
  WHERE id = 'GMLID_BUI100628_817_8083'
  EXCEPT ALL
  SELECT texture_lod3_0['visual'][1][1].uv
  FROM read_cityjsonseq('test/data/railway_appearance.city.jsonl', lod => '3')
  WHERE id = 'GMLID_BUI100628_817_8083'
);
----
0
