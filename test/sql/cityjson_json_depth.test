# name: test/sql/cityjson_json_depth.test
# description: JSON nested deeper than the parse limit is refused with an error, never by exhausting the stack
# group: [sql]

require cityjson

require parquet

# nlohmann parses iteratively but copies and serialises recursively, so a valid JSON
# text nested a million levels deep -- which a CityJSON file, a cell or a Parquet footer
# can hold -- took the process down wherever this extension parsed it and then used the
# result. Every parse now refuses nesting deeper than 256 levels first; real CityJSON
# nests about a dozen.

# The limit itself: 256 levels parse, 257 do not.
query I
SELECT cityparquet_json(repeat('[', 256) || repeat(']', 256)) IS NOT NULL;
----
true

statement error
SELECT cityparquet_json(repeat('[', 257) || repeat(']', 257));
----
nests deeper than 256 levels

# A CityJSONSeq feature whose attribute nests a hundred thousand levels deep: delft_subset's
# header, then one such feature, written out as plain lines.
statement ok
COPY (SELECT line FROM (
  SELECT 0 AS o, string_split((SELECT content FROM read_text('test/data/delft_subset.city.jsonl')), chr(10))[1] AS line
  UNION ALL
  SELECT 1, '{"type":"CityJSONFeature","id":"deep","CityObjects":{"deep":{"type":"Building","attributes":{"nest":'
            || repeat('[', 100000) || repeat(']', 100000) || '}}},"vertices":[]}') ORDER BY o)
TO '__TEST_DIR__/deep.city.jsonl' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement error
SELECT COUNT(*) FROM read_cityjsonseq('__TEST_DIR__/deep.city.jsonl');
----
nests deeper than 256 levels

# The same depth in a table's `other`, going out through COPY and through the package
# writer.
statement ok
CREATE SCHEMA d;

statement ok
CREATE TABLE d.building AS SELECT * FROM read_cityjsonseq('test/data/delft_subset.city.jsonl');

statement ok
PRAGMA cityparquet_init('d');

statement ok
UPDATE d.building SET other = '{"nest":' || repeat('[', 1000000) || repeat(']', 1000000) || '}'
WHERE id = 'NL.IMBAG.Pand.0503100000012869';

statement error
COPY (SELECT * FROM d.building) TO '__TEST_DIR__/deep_out.city.jsonl' (FORMAT cityjsonseq);
----
nests deeper than 256 levels

statement error
SELECT COUNT(*) FROM cityparquet_write('d', '__TEST_DIR__/deep_pkg', crs => 'EPSG:7415');
----
nests deeper than 256 levels

# And in a package's carried footer: unreadable, so the writer regenerates it, and
# cityparquet_city_field reads nothing from it.
statement ok
UPDATE d.building SET other = NULL;

statement ok
UPDATE d.__cityparquet SET city = '{"other":' || repeat('[', 1000000) || repeat(']', 1000000) || '}';

query I
SELECT cityparquet_city_field(city, 'other') IS NULL FROM d.__cityparquet;
----
true

statement ok
SELECT COUNT(*) FROM cityparquet_write('d', '__TEST_DIR__/deep_pkg', crs => 'EPSG:7415');

query I
SELECT COUNT(*) FROM read_parquet('__TEST_DIR__/deep_pkg/building.parquet');
----
20

# --- a LIST value, written as a JSON array ----------------------------------------------
# cityparquet_to_json and COPY turn a LIST attribute into a JSON array one level per list
# level; the same limit holds, so a list nested 257 deep is refused, not recursed into.

query I
SELECT length(CAST(cityparquet_to_json([[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]) AS VARCHAR));
----
513

statement error
SELECT cityparquet_to_json([[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]);
----
nests deeper than 256 levels

statement ok
CREATE TABLE deep_list AS
SELECT * EXCLUDE (other), [[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]] AS nest256, [[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]] AS nest257, other
FROM read_cityjsonseq('test/data/delft_subset.city.jsonl') LIMIT 1;

statement ok
COPY (SELECT * EXCLUDE (nest257) FROM deep_list) TO '__TEST_DIR__/deep256.city.jsonl' (FORMAT cityjsonseq);

statement error
COPY (SELECT * EXCLUDE (nest256) FROM deep_list) TO '__TEST_DIR__/deep257.city.jsonl' (FORMAT cityjsonseq);
----
nests deeper than 256 levels

# A package file whose schema nests: cityparquet_read walks the footer's flat element
# list without a stack frame per level -- a footer may declare any depth there -- and
# finds the top-level columns as they are. (DuckDB's own Parquet reader slows
# exponentially with list depth and stops at 255 definition levels, so the file a test
# can read back nests 20.)
statement ok
COPY (SELECT * EXCLUDE (other), [[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]] AS nest20, other
      FROM read_cityjsonseq('test/data/delft_subset.city.jsonl') LIMIT 1)
TO '__TEST_DIR__/deep_pkg/building.parquet' (FORMAT parquet);

statement ok
PRAGMA cityparquet_read('__TEST_DIR__/deep_pkg', 'deep_read');

query II
SELECT COUNT(*) FILTER (WHERE column_name IN ('nest20', 'other')), COUNT(*) FILTER (WHERE column_name LIKE '%\_1' ESCAPE '\')
FROM information_schema.columns WHERE table_schema = 'deep_read' AND table_name = 'building';
----
2	0
