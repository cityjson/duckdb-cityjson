# name: test/sql/cityjson_bind_data_copy.test
# description: bind data survives plan copies with appearance intact (review P2)
# group: [sql]

require cityjson

# The sidecar appearance rewrite: a plan copy that loses appearance_index would
# emit feature-local indices on one side and sidecar ids on the other.
query I
WITH src AS (SELECT * FROM read_cityjsonseq('test/data/railway_appearance.city.jsonl', appearance := 'sidecar'))
SELECT COUNT(*) FROM src a JOIN src b ON a.id = b.id
WHERE a.material_lod3_0 IS DISTINCT FROM b.material_lod3_0;
----
0
