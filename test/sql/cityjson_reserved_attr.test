# name: test/sql/cityjson_reserved_attr.test
# description: an attribute colliding case-insensitively with a reserved column is the escaped column _<name>
# group: [sql]

require cityjson

# The source has an attribute "ID" that collides case-insensitively with the reserved
# "id" column. It is the column "_ID" (spec 02-object-table-schema.mdx, "Column naming
# and reservation rules"), so the reader binds although DuckDB's column names are
# case-insensitive.
statement ok
CREATE TABLE collide AS SELECT * FROM read_cityjson('test/data/reserved_attr_collision.city.json');

# One reserved id column, and the attribute under its escaped name.
query T
SELECT string_agg(column_name, ',' ORDER BY column_name) FROM (DESCRIBE SELECT * FROM collide)
WHERE lower(ltrim(column_name, '_')) = 'id';
----
_ID,id

# The structural id column holds the CityObject key, not the attribute value.
query T
SELECT id FROM collide;
----
building1

# The attribute's value is in its own column, not in `other`.
query TT
SELECT "_ID", other FROM collide;
----
attr-id-value	NULL

# Non-colliding attributes still get their own typed column.
query R
SELECT measuredHeight FROM collide;
----
12.0
