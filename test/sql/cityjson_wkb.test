# name: test/sql/cityjson_wkb.test
# description: Test WKB geometry encoding for CityJSON
# group: [sql]

# This test file validates the WKB encoding infrastructure and the
# LOD parameter for read_cityjson() that enables per-LOD table schema.

require cityjson

# Test basic CityJSON reading still works with new encoding infrastructure
statement ok
CREATE TABLE buildings AS SELECT * FROM read_cityjson('test/data/minimal.city.json');

# Verify the table was created and has geometry data
query I
SELECT COUNT(*) FROM buildings;
----
1

# Default mode now emits per-LOD WKB geometry + properties columns (CityParquet layout)
query T
SELECT typeof(geometry_lod2_2) FROM buildings WHERE geometry_lod2_2 IS NOT NULL;
----
BLOB

query T
SELECT typeof(geometry_properties_lod2_2) FROM buildings;
----
STRUCT("type" VARCHAR, surfaces VARCHAR, face_semantics INTEGER[], shells INTEGER[][])

# geometry_properties is the spec's flattened, face-aligned STRUCT
# {type, surfaces, face_semantics, shells}. This Solid has one shell of one face
# and no semantics, so only `type` and `shells` are populated -- and `shells` is
# nested one list per solid, so a lone Solid reads [[1]] rather than [1].
query TTTT
SELECT geometry_properties_lod2_2."type",
       geometry_properties_lod2_2.surfaces,
       geometry_properties_lod2_2.face_semantics,
       geometry_properties_lod2_2.shells
FROM buildings;
----
Solid	NULL	NULL	[[1]]

# Clean up
statement ok
DROP TABLE buildings;

# ============================================================
# Spec §8 flattened semantics (surfaces + face_semantics + shells)
# ============================================================

# A real Delft Solid with per-surface semantics. Its CityJSON semantics
# values [[0,2,2,2,2,1]] (one shell, six faces) flatten to a per-face
# face_semantics array aligned to the WKB face order; shells records the
# six-face shell as [[6]] (one list per solid); surfaces is preserved verbatim,
# in order, including the extended `on_footprint_edge` attributes WKB cannot hold.
query TTT
SELECT geometry_properties_lod2_2."type",
       geometry_properties_lod2_2.face_semantics,
       geometry_properties_lod2_2.shells
FROM read_cityjsonseq('test/data/delft_subset.city.jsonl')
WHERE id = 'NL.IMBAG.Pand.0503100000012869-0';
----
Solid	[0, 2, 2, 2, 2, 1]	[[6]]

query T
SELECT geometry_properties_lod2_2.surfaces
FROM read_cityjsonseq('test/data/delft_subset.city.jsonl')
WHERE id = 'NL.IMBAG.Pand.0503100000012869-0';
----
[{"type":"GroundSurface"},{"type":"RoofSurface"},{"on_footprint_edge":true,"type":"WallSurface"},{"on_footprint_edge":false,"type":"WallSurface"}]

# ============================================================
# Tests for LOD parameter with WKB geometry encoding
# ============================================================

# Test reading with LOD parameter (uses per-LOD table schema with WKB encoding)
statement ok
CREATE TABLE buildings_lod AS SELECT * FROM read_cityjson('test/data/minimal.city.json', lod => '2.2');

# Verify the table has the expected columns for per-LOD schema
query I
SELECT COUNT(*) FROM buildings_lod;
----
1

# `lod=` mode uses the same suffixed column grammar as the wide layout, so the
# geometry column is geometry_lod2_2 (never a bare `geometry`) and its LoD stays
# recoverable from the name.
query T
SELECT typeof(geometry_lod2_2) FROM buildings_lod;
----
BLOB

query T
SELECT typeof(geometry_properties_lod2_2) FROM buildings_lod;
----
STRUCT("type" VARCHAR, surfaces VARCHAR, face_semantics INTEGER[], shells INTEGER[][])

# Verify 'object_type' column exists
query T
SELECT object_type FROM buildings_lod;
----
Building

# Cleanup
statement ok
DROP TABLE buildings_lod;

# Test that invalid LOD throws an error
statement error
SELECT * FROM read_cityjson('test/data/minimal.city.json', lod => '9.9');
----
LOD '9.9' not found

# Both modes use the same suffixed column grammar — a bare `geometry` column is
# never emitted. What `lod=` changes is how many LoDs are present, not how they
# are named: the multi-LoD Delft fixture yields four geometry columns in the wide
# layout and exactly the requested one under `lod=`.
query II
SELECT COUNT(*) FILTER (WHERE column_name LIKE 'geometry_lod%'),
       COUNT(*) FILTER (WHERE column_name = 'geometry')
FROM (DESCRIBE SELECT * FROM read_cityjsonseq('test/data/delft_subset.city.jsonl'))
UNION ALL
SELECT COUNT(*) FILTER (WHERE column_name LIKE 'geometry_lod%'),
       COUNT(*) FILTER (WHERE column_name = 'geometry')
FROM (DESCRIBE SELECT * FROM read_cityjsonseq('test/data/delft_subset.city.jsonl', lod => '2.2'));
----
4	0
1	0

# ============================================================
# LOD normalization
# ============================================================

# Numeric LOD in file (2.0) is normalized so '2' and '2.0' both match
query I
SELECT COUNT(*) FROM read_cityjson('test/data/numeric_lod.city.json', lod => '2');
----
1

query I
SELECT COUNT(*) FROM read_cityjson('test/data/numeric_lod.city.json', lod => '2.0');
----
1

# Default schema uses the normalized column name, always with a minor
# (geometry_lod2_0 for numeric 2.0, never the bare geometry_lod2 — spec §9)
query T
SELECT typeof(geometry_lod2_0) FROM read_cityjson('test/data/numeric_lod.city.json') WHERE geometry_lod2_0 IS NOT NULL;
----
BLOB

query T
SELECT typeof(geometry_properties_lod2_0) FROM read_cityjson('test/data/numeric_lod.city.json') WHERE geometry_properties_lod2_0 IS NOT NULL;
----
STRUCT("type" VARCHAR, surfaces VARCHAR, face_semantics INTEGER[], shells INTEGER[][])
