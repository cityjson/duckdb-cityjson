# name: test/sql/cityparquet_io.test
# description: cityparquet_write / cityparquet_read — the package round trip
# group: [sql]

require cityjson

require parquet

statement ok
CREATE SCHEMA ams;

statement ok
CREATE TABLE ams.building AS
  SELECT * FROM read_cityjsonseq('test/data/delft_subset.city.jsonl');

statement ok
PRAGMA cityparquet_init('ams');

# A hand-rolled load discarded the footer, so the writer must be told the CRS.
# Writing a file with CRS-bearing coordinates and no crs is a conversion error,
# never a silent omission.
statement error
SELECT * FROM cityparquet_write('ams', '__TEST_DIR__/pkg_nocrs');
----
crs

query I
SELECT COUNT(*) > 0 FROM cityparquet_write('ams', '__TEST_DIR__/pkg', crs => 'EPSG:7415');
----
true

# One data file per non-empty object table.
query T
SELECT file FROM cityparquet_write('ams', '__TEST_DIR__/pkg', crs => 'EPSG:7415')
WHERE file LIKE '%.parquet' ORDER BY file;
----
building.parquet

# The written package reads back with every row intact.
query I
SELECT COUNT(*) FROM read_parquet('__TEST_DIR__/pkg/building.parquet');
----
20

# The footer carries a `city` object with the CRS resolved to PROJJSON.
query I
SELECT COUNT(*) FROM parquet_kv_metadata('__TEST_DIR__/pkg/building.parquet')
WHERE key = 'city';
----
1

query T
SELECT cityparquet_city_field(decode(value), 'version')
FROM parquet_kv_metadata('__TEST_DIR__/pkg/building.parquet') WHERE key = 'city';
----
0.1.0-draft

# This fixture carries a legal LoD0 footprint (MultiPolygon Z) alongside solid
# LoDs (PolyhedralSurface Z), so `geo` is written -- but declaring ONLY the
# footprint. Declaring a solid column would make the whole file unreadable to
# Shapely, GeoPandas and DuckDB spatial, taking the good column down with it.
query I
SELECT COUNT(*) FROM parquet_kv_metadata('__TEST_DIR__/pkg/building.parquet')
WHERE key = 'geo';
----
1

query T
SELECT cityparquet_city_field(decode(value), 'primary_column')
FROM parquet_kv_metadata('__TEST_DIR__/pkg/building.parquet') WHERE key = 'geo';
----
geometry_lod0_0

# No solid column appears anywhere in the geo object.
query I
SELECT COUNT(*) FROM parquet_kv_metadata('__TEST_DIR__/pkg/building.parquet')
WHERE key = 'geo' AND decode(value) LIKE '%PolyhedralSurface%';
----
0

# city, by contrast, registers EVERY geometry column including the solids, and
# its primary is the finest analysis geometry. The two primaries legitimately
# differ -- there is no rule that they match.
query T
SELECT cityparquet_city_field(decode(value), 'primary_column')
FROM parquet_kv_metadata('__TEST_DIR__/pkg/building.parquet') WHERE key = 'city';
----
geometry_lod2_2

query I
SELECT COUNT(*) FROM parquet_kv_metadata('__TEST_DIR__/pkg/building.parquet')
WHERE key = 'city' AND decode(value) LIKE '%PolyhedralSurface%';
----
1

# metadata.json is written as a STAC Item.
query I
SELECT COUNT(*) FROM cityparquet_write('ams', '__TEST_DIR__/pkg', crs => 'EPSG:7415')
WHERE file = 'metadata.json';
----
1

# cityparquet_read loads the package back, and recovers the footer that a
# hand-rolled read_parquet load would have thrown away.
statement ok
PRAGMA cityparquet_read('__TEST_DIR__/pkg', 'back');

query I
SELECT COUNT(*) FROM back.building;
----
20

query TT
SELECT table_name, role FROM back.__cityparquet ORDER BY table_name;
----
building	object

query I
SELECT city IS NOT NULL FROM back.__cityparquet WHERE table_name = 'building';
----
true

# Round trip: the reloaded package validates clean and still reconciles to a
# no-op, so nothing was lost or distorted by the write.
statement ok
PRAGMA cityparquet_validate('back');

query I
SELECT COUNT(*) FROM cityparquet_validation WHERE severity = 'error';
----
0
