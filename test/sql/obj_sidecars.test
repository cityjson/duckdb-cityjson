# name: test/sql/obj_sidecars.test
# description: obj_materials and obj_textures expose the .mtl as CityParquet sidecar rows
# group: [sql]

require cityjson

# A directive the .mtl does not carry is NULL, not an invented zero: GroundSurface
# states only `Kd`, so its `Ks`, `Ke`, `Ka`, `d`/`Tr` and `Ns` columns are unknown.
query IIIIIII
SELECT id, name, ambientIntensity, diffuseColor, specularColor, transparency, shininess
FROM obj_materials('test/data/obj/cube.obj');
----
0	GroundSurface	NULL	[0.3, 0.3, 0.3]	NULL	NULL	NULL
1	brick	NULL	[0.7, 0.3, 0.2]	[0.1, 0.1, 0.1]	0.3	0.0007
2	RoofSurface	NULL	[0.9, 0.06, 0.09]	NULL	0.3	NULL

query II
SELECT id, emissiveColor FROM obj_materials('test/data/obj/cube.obj');
----
0	NULL
1	NULL
2	NULL

# Every directive this mapping does not cover lands in `other` verbatim, whether or not
# tinyobjloader has a typed field of its own for it (`illum` and `map_Ks` both do).
query II
SELECT id, other FROM obj_materials('test/data/obj/cube.obj');
----
0	NULL
1	{"illum":"2","map_Ks":"spec.png"}
2	NULL

# transparency/shininess are DOUBLE, which sqllogictest compares approximately (a
# 0.09999999999999998-for-0.1 drift would still pass above), so pin the exact
# correctly-rounded digits through a VARCHAR cast instead -- the way read_obj.test pins
# bbox. brick's `d`/`Ns` are single fractional digits (0.7), not the round 0.9/250 a
# fixture might reach for, because 0.9 and 250 happen to parse identically under
# tinyobjloader's not-correctly-rounded number parser and under strtod: only a value
# like 0.7 makes the two parses printably disagree, so only a value like this can catch
# a regression in ReparseMtl's `d`/`Ns` branches.
# RoofSurface states `Tr 0.3`, which is transparency directly -- a 1 - (1 - Tr) round
# trip through tinyobjloader's `dissolve` would print 0.30000000000000004 here.
query III
SELECT id, transparency::VARCHAR, shininess::VARCHAR FROM obj_materials('test/data/obj/cube.obj');
----
0	NULL	NULL
1	0.30000000000000004	0.0007
2	0.3	NULL

# Same columns, same order, as cityjson_materials -- a package writer must not care which produced them.
query I
SELECT list_aggregate(list(column_name ORDER BY column_index), 'string_agg', ',')
FROM (SELECT column_name, row_number() OVER () AS column_index FROM (DESCRIBE SELECT * FROM obj_materials('test/data/obj/cube.obj')));
----
id,name,ambientIntensity,diffuseColor,specularColor,emissiveColor,transparency,shininess,isSmooth,other

query IIIIII
SELECT id, image_uri, image_data, image_type, wrapMode, textureType FROM obj_textures('test/data/obj/cube.obj');
----
0	brick.png	NULL	PNG	wrap	unknown

query I
SELECT COUNT(*) FROM obj_materials('test/data/obj/open_roof.obj');
----
0

# A .mtl holding nothing but a comment defines no material: tinyobjloader's
# unconditional final flush would otherwise hand back one with an empty name.
query I
SELECT COUNT(*) FROM obj_materials('test/data/obj/empty_mtl.obj');
----
0
