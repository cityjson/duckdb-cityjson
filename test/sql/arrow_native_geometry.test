# name: test/sql/arrow_native_geometry.test
# description: arrow-native geometry encoding — column types and schema shape
# group: [sql]

require cityjson

# Experimental second geometry encoding (branch arrow-native-type; design:
# docs/superpowers/specs/2026-07-25-arrow-native-geometry-design.md in the parent
# workspace repo). `geometry_lod*` becomes a 5-level nested LIST of vertex-pool
# indices -- solid -> shell -> face -> ring -> index -- paired with a
# `geometry_vertices_lod*` sibling holding this row's compacted vertex pool.
#
# The physical shape MUST match cityparquet-rs's arrow_native_geometry_data_type()
# and arrow_native_vertices_data_type() field-for-field: a file either producer
# writes has to be readable by the other.

# The parameter takes exactly two values. Anything else is rejected at bind
# rather than silently falling back to WKB, which would hand back a file in the
# wrong encoding with no indication anything was ignored.
statement error
SELECT * FROM read_cityjson('test/data/minimal.city.json', geometry_encoding := 'not-a-real-encoding');
----
geometry_encoding must be 'wkb' or 'arrow-native'

statement error
SELECT * FROM read_cityjsonseq('test/data/sample.city.jsonl', geometry_encoding := 'not-a-real-encoding');
----
geometry_encoding must be 'wkb' or 'arrow-native'

# 'wkb' is accepted explicitly and is identical to omitting the parameter.
query T
SELECT typeof(geometry_lod2_2) FROM read_cityjson('test/data/minimal.city.json', geometry_encoding := 'wkb');
----
BLOB

statement ok
CREATE TABLE t AS SELECT * FROM read_cityjson('test/data/minimal.city.json', geometry_encoding := 'arrow-native');

query T
SELECT typeof(geometry_lod2_2) FROM t;
----
INTEGER[][][][][]

query T
SELECT typeof(geometry_vertices_lod2_2) FROM t;
----
STRUCT(x DOUBLE, y DOUBLE, z DOUBLE)[]

# geometry_properties is unchanged by the encoding -- it is the same spec STRUCT
# either way, and stays the sole basis on which a consumer decides whether a row
# is a Solid or a MultiSurface (design doc "Critical invariant": dispatch on
# .type, never on the physical nesting, which is uniform across both families).
query T
SELECT typeof(geometry_properties_lod2_2) FROM t;
----
STRUCT("type" VARCHAR, surfaces VARCHAR, face_semantics INTEGER[], shells INTEGER[][])

# The fixture is a Solid with one shell, one face, one ring of four vertices --
# so the nesting is solids(1) -> shells(1) -> faces(1) -> rings(1) -> 4 indices.
# The outermost level is the padding dimension; the shell level is real structure.
query T
SELECT geometry_lod2_2 FROM t;
----
[[[[[0, 1, 2, 3]]]]]

# The pool carries the vertices the geometry references, dereferenced through the
# file's transform, in first-seen order.
query T
SELECT geometry_vertices_lod2_2 FROM t;
----
[{'x': 0.0, 'y': 0.0, 'z': 0.0}, {'x': 10.0, 'y': 0.0, 'z': 0.0}, {'x': 10.0, 'y': 10.0, 'z': 0.0}, {'x': 0.0, 'y': 10.0, 'z': 0.0}]

# Every index is a valid position in this row's own pool -- the invariant a reader
# relies on to dereference without a bounds check per element.
query I
SELECT count(*) FROM (
  SELECT unnest(geometry_lod2_2, recursive := true) AS idx,
         len(geometry_vertices_lod2_2) AS pool FROM t
) WHERE idx < 0 OR idx >= pool;
----
0

# Face count agrees with the WKB encoding of the same object, read independently:
# the two encodings describe the same topology, and geometry_properties.shells --
# which is unchanged by the encoding -- says how many faces each shell has.
query II
SELECT (SELECT len(geometry_lod2_2[1][1]) FROM t),
       (SELECT geometry_properties_lod2_2.shells[1][1] FROM t);
----
1	1

statement ok
DROP TABLE t;

# CityJSONSeq over real data: the vertex pool is per-feature rather than global, so
# this exercises a different pool resolution than the file above, across a fixture
# carrying both in-scope families -- MultiSurface at LoD0.0, Solid at LoD2.2.
statement ok
CREATE TABLE s AS SELECT * FROM read_cityjsonseq('test/data/delft_subset.city.jsonl', geometry_encoding := 'arrow-native');

query T
SELECT DISTINCT typeof(geometry_vertices_lod2_2) FROM s;
----
STRUCT(x DOUBLE, y DOUBLE, z DOUBLE)[]

# Pairing invariant: a geometry cell and its vertex-pool sibling are null together
# or non-null together, never one without the other.
query I
SELECT count(*) FROM s
WHERE (geometry_lod2_2 IS NULL) <> (geometry_vertices_lod2_2 IS NULL)
   OR (geometry_lod0_0 IS NULL) <> (geometry_vertices_lod0_0 IS NULL);
----
0

# Every index in every row is in range for that row's own pool. A reader
# dereferences on this basis, so an out-of-range index is not encodable data.
query I
SELECT count(*) FROM (
  SELECT unnest(geometry_lod2_2, recursive := true) AS idx,
         len(geometry_vertices_lod2_2) AS pool
  FROM s WHERE geometry_lod2_2 IS NOT NULL
) WHERE idx < 0 OR idx >= pool;
----
0

# Compaction is real, and this is the storage claim the encoding rests on: the
# pools hold far fewer vertices in total than the boundaries reference, because a
# vertex shared between adjacent faces is stored once per object rather than once
# per occurrence -- which WKB, having no index concept, cannot do at all.
query II
SELECT (SELECT sum(len(geometry_vertices_lod2_2)) FROM s),
       (SELECT count(*) FROM (SELECT unnest(geometry_lod2_2, recursive := true) FROM s));
----
230	728

# Padding dimensions: a MultiSurface has no solid or shell concept, so both outer
# levels are length 1 and carry no meaning. Its faces live at the third level.
query I
SELECT count(*) FROM s
WHERE geometry_lod0_0 IS NOT NULL
  AND (len(geometry_lod0_0) <> 1 OR len(geometry_lod0_0[1]) <> 1);
----
0

# ... whereas for the Solid rows the shell level is real structure, not padding:
# it agrees with geometry_properties.shells, which the encoding leaves untouched.
query I
SELECT count(*) FROM s
WHERE geometry_lod2_2 IS NOT NULL
  AND len(geometry_lod2_2[1]) <> len(geometry_properties_lod2_2.shells[1]);
----
0

# Face counts agree with geometry_properties.shells face-per-shell counts, which
# is what lets face_semantics keep indexing faces in the same traversal order
# under either encoding.
query I
SELECT count(*) FROM s
WHERE geometry_lod2_2 IS NOT NULL
  AND len(geometry_lod2_2[1][1]) <> geometry_properties_lod2_2.shells[1][1];
----
0

statement ok
DROP TABLE s;

# The default encoding is WKB, and is completely unaffected: a BLOB geometry
# column and no vertices sibling at all.
statement ok
CREATE TABLE d AS SELECT * FROM read_cityjson('test/data/minimal.city.json');

query T
SELECT typeof(geometry_lod2_2) FROM d;
----
BLOB

query I
SELECT count(*) FROM (DESCRIBE d) WHERE column_name LIKE 'geometry_vertices%';
----
0

statement ok
DROP TABLE d;

# ============================================================
# `geo` emission is encoding-aware
# ============================================================
#
# GeoParquet's `geo` declares WKB columns. A MultiSurface is GeoParquet-legal
# *when encoded as WKB* -- but the same CityJSON type encoded arrow-native is a
# nested LIST no GeoParquet reader can decode, so it must not be declared at all.
# Legality is a property of the physical encoding, not of the CityJSON type.

# Default: delft's LoD0.0 MultiSurface is legal WKB, so it is declared.
query I
SELECT geo IS NOT NULL FROM cityjson_geoparquet_geo('test/data/delft_subset.city.jsonl');
----
true

# Arrow-native: nothing is declared, even though the CM types are unchanged.
query I
SELECT geo IS NULL FROM cityjson_geoparquet_geo('test/data/delft_subset.city.jsonl', geometry_encoding := 'arrow-native');
----
true

# 'wkb' spelled out explicitly matches the default.
query I
SELECT geo IS NOT NULL FROM cityjson_geoparquet_geo('test/data/delft_subset.city.jsonl', geometry_encoding := 'wkb');
----
true

statement error
SELECT geo FROM cityjson_geoparquet_geo('test/data/delft_subset.city.jsonl', geometry_encoding := 'nonsense');
----
geometry_encoding must be 'wkb' or 'arrow-native'

# ============================================================
# COPY TO cityjson refuses arrow-native input
# ============================================================
#
# Writing CityJSON back out needs WKB geometry to decode. Under the arrow-native
# encoding geometry_lod* is a nested LIST the CityJSON writer cannot read, and
# geometry_vertices_lod* is not an attribute despite sharing the geometry_ prefix.
# Left alone, both misread silently: the geometry came out as [] and the vertex
# pool was serialised into attributes as a display string. Decoding arrow-native
# back to CityJSON is out of phase-1 scope, so this must fail loudly instead.

statement error
COPY (SELECT * FROM read_cityjson('test/data/minimal.city.json', geometry_encoding := 'arrow-native'))
TO '__TEST_DIR__/arrow_native_reject.city.json' (FORMAT cityjson);
----
arrow-native

# The same COPY under the default encoding is unaffected.
statement ok
COPY (SELECT * FROM read_cityjson('test/data/minimal.city.json'))
TO '__TEST_DIR__/arrow_native_wkb_ok.city.json' (FORMAT cityjson);

# ============================================================
# geometry_vertices_lod* is a reserved structural name
# ============================================================
#
# The generated vertex-pool column is inserted by name, so a source attribute
# literally called geometry_vertices_lod2_2 would otherwise get its own attribute
# column and collide with it -- two columns of one name, with the structural one
# no longer reliably reachable. geometry_lod*/geometry_properties* are already
# reserved for exactly this reason; this prefix has to be too.

statement ok
CREATE TABLE c AS SELECT * FROM read_cityjson('test/data/geometry_vertices_attr_collision.city.json', geometry_encoding := 'arrow-native');

query I
SELECT count(*) FROM (DESCRIBE c) WHERE lower(column_name) = 'geometry_vertices_lod2_2';
----
1

# The surviving column is the structural vertex pool, not the attribute string.
query T
SELECT typeof(geometry_vertices_lod2_2) FROM c;
----
STRUCT(x DOUBLE, y DOUBLE, z DOUBLE)[]

# ... and the attribute's value is preserved in the `other` catch-all, as the
# existing reserved-name handling already does for id/geometry_lod*.
query T
SELECT other::VARCHAR LIKE '%attr-collides-with-vertex-pool%' FROM c;
----
true

statement ok
DROP TABLE c;

# The name is reserved regardless of encoding: under the default WKB layout no
# such column is generated, but the attribute must not claim the reserved name.
query I
SELECT count(*) FROM (
  DESCRIBE SELECT * FROM read_cityjson('test/data/geometry_vertices_attr_collision.city.json')
) WHERE lower(column_name) = 'geometry_vertices_lod2_2';
----
0

# --- shell padding: a Solid's shells are FLATTENED, not nested ------------------
#
# This is the cross-producer contract, and it is not intuitive. A CityJSON
# `Solid` carries a list of shells (index 0 exterior, the rest cavities), but
# the arrow-native geometry column pads BOTH the solid and the shell level to
# length 1 for every Solid: all shells' faces go into that one shell, exactly as
# the WKB path flattens them into one PolyhedralSurface. The real partition
# survives only in `geometry_properties.shells`.
#
# cityparquet-rs does the same (`push_padded_solid` in arrow_geom_write.rs), and
# duckdb-3d's ST_3DFromArrowNative REQUIRES it -- it raises "expected exactly one
# padded shell per solid when geometry_properties.shells is present" otherwise.
# Emitting genuine nesting here would double-count the cavity's faces against the
# shells metadata, so a hollow solid would not cross to duckdb-3d at all.

statement ok
CREATE TABLE hollow AS SELECT * FROM read_cityjson(
  'test/data/hollow_solid.city.json', lod => '2', geometry_encoding := 'arrow-native');

# One solid, and exactly one (padded) shell inside it, holding all 12 faces of
# both shells -- 6 exterior + 6 cavity.
query III
SELECT len(geometry_lod2_0)       AS solids,
       len(geometry_lod2_0[1])    AS shells,
       len(geometry_lod2_0[1][1]) AS faces
FROM hollow;
----
1	1	12

# The partition that the padding drops is preserved in the metadata, per spec §8.
query T
SELECT geometry_properties_lod2_0.shells::VARCHAR FROM hollow;
----
[[6, 6]]

# The vertex pool still compacts the distinct source indices actually referenced.
query I
SELECT len(geometry_vertices_lod2_0) FROM hollow;
----
16

statement ok
DROP TABLE hollow;

# A MultiSolid keeps one solid per member, each member's shells likewise padded
# to a single shell -- the solid dimension is the only real one there.
query II
SELECT len(geometry_lod2_2) AS solids, len(geometry_lod2_2[1]) AS shells_in_first
FROM read_cityjson('test/data/multisolid.city.json', lod => '2.2', geometry_encoding := 'arrow-native');
----
2	1
